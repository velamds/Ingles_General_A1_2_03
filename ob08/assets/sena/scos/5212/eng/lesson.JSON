ck": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}], "allowed_attempts": 2}}]}, {"template_override": 1, "stimuli_ids": [], "questions": [{"responses": [{"selected": 0, "_data": [{"type": "text", "content": ""}], "id": 0, "correct": 1}], "_data": [{"type": "question", "contents": [{"type": "pdf", "content": "engenn3le03ob08re7pdf01.pdf"}]}], "id": 0}], "type": "DWS", "id": 11, "_data": [{"type": "instructions", "contents": [{"type": "text", "content": "In the lesson, you wrote a movie review. Now, write a book review!"}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Take Away"}]}, {"type": "feedback", "content": {"correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}], "allowed_attempts": 2}}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Speaking"}, {"type": "skill", "content": "Reading"}]}, {"type": "post_instructions", "contents": [{"type": "text", "content": "Instructions: Complete the following steps. Fill in the Self-Assessment. "}]}]}], "type": "scholar", "_data": [{"type": "lab_options", "contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}]}], "id": 0, "stimuli": [{"type": "welcome", "id": 0, "_data": [], "contents": [{}], "template_override": 1}, {"title": "", "id": 1, "template_override": 1, "type": "audio", "_data": [], "contents": [{"type": "slideshow", "value": {"audiosrc": "engenn3le03ob08re2aud01", "coverimg": "engenn3le03ob08re2img05.jpg", "images": [{"text": "", "image": "engenn3le03ob08re2img05.jpg", "time": "0", "id": 0}, {"text": "<span class=\"strong\">Peter: </span>So, what did you think?<br/>\n<span class=\"strong\">Vanessa</span>: Of <span class = \"italic\">The Letter</span>? Well, you know I love romances. The characters, Sharon Simons and Ben Styler, were so believable.<br/><span class=\"strong\">Peter</span>: I thought that it was a little boring. I prefer action movies. Plus, it seemed too long to me - 2.5 hours!", "image": "engenn3le03ob08re2img05.jpg", "time": "100", "id": 1}, {"text": "<span class=\"strong\">Vanessa</span>: Well, I really enjoyed the French setting. It was interesting to watch a movie about a couple in Paris in the 1940's. Everything was so different then, like sending letters instead of e-mails and texts.<br/>\n<span class=\"strong\">Peter</span>: I guess ... The director, Robert O'Neill also makes other types of movies ... The types I prefer more ... <br/>\n<span class=\"strong\">Vanessa</span>: Oh, Peter, didn't you like that he was a pilot in the war? There was a lot of action in those parts.", "image": "engenn3le03ob08re2img05.jpg", "time": "19340", "id": 2}, {"text": "<span class=\"strong\">Peter</span>: Some of it, yes, but when he died, the whole movie theater was crying, including you, Vanessa. <br/>\n<span class=\"strong\">Vanessa</span>: Hey, it was sad in the end. I think John and Sally need to see the movie. I'm going to recommend  they watch it. I really enjoyed it.<br/>\n<span class=\"strong\">Peter</span>: Sorry, I don't agree with you. <br/>\n<span class=\"strong\">Vanessa</span>: And, by the way, Peter, there were tears in your eyes too!", "image": "engenn3le03ob08re2img01.jpg", "time": "47300", "id": 3}]}}]}, {"title": "", "id": 2, "template_override": 1, "type": "video", "_data": [], "contents": [{"type": "video", "value": {"video_src": "engenn3le03ob08re3vid01", "images": [{"text": "", "image": "", "time": "0", "id": 0}, {"text": "<span class = \"bullet\">Movie review</span", "image": "", "time": "5000", "id": 1}, {"text": "<span class = \"bullet\"</span> What do you include?", "image": "", "time": "11000", "id": 2}]}}]}]}], "type": "sena", "_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "At the Movies"}, {"type": "unit_name", "content": "What Did You Think of the Movie?"}, {"type": "position", "content": 8}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 3}, {"type": "level", "content": "A1.2"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Describe past experiences in communicative situations."}, {"type": "secondary_1", "content": "Communicates effectively in English about the communicative topics for this level through the use of appropriate basic vocabulary and grammatical structures, and with intelligible pronunciation."}, {"type": "secondary_2", "content": "Identifies general aspects of personal information in short written or spoken conversations about past experiences."}, {"type": "secondary_3", "content": "Communicates effectively in English about the communicative topics for this level through the use of appropriate basic vocabulary and grammatical structures, and with intelligible pronunciation."}, {"type": "secondary_4", "content": "write a short film review using the Simple Past."}, {"type": "secondary_5", "content": "Identifies general aspects of personal information in short written or spoken conversations about past experiences."}, {"type": "secondary_6", "content": " Communicates effectively in English about the communicative topics for this level through the use of appropriate basic vocabulary and grammatical structures, and with intelligible pronunciation."}, {"type": "secondary_7", "content": "Communicates effectively in English about the communicative topics for this level through the use of appropriate basic vocabulary and grammatical structures, and with intelligible pronunciation."}, {"type": "secondary_8", "content": "Communicates effectively in English about the communicative topics for this level through the use of appropriate basic vocabulary and grammatical structures, and with intelligible pronunciation."}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Subject and Object Pronouns "}, {"type": "describer", "content": "We use subject pronouns as subjects of sentences and object pronouns as objects."}, {"type": "text", "content": "<span class=\"strong\">Subject Pronouns</span>"}, {"type": "table", "content": "{\"rows\":4,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Singular\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Plural\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"we\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"you\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"you\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"he/she/it   \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"they\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}"}, {"type": "text", "content": "Subjects go at the start of the sentence. They do the action."}, {"type": "text", "content": "<span class=\"italic\">Example: <br>Peter goes to movies.</br>He goes to movies.</span>"}, {"type": "text", "content": "<span class=\"strong\">Object Pronouns</span>"}, {"type": "table", "content": "{\"rows\":4,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Singular\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Plural\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" me\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"us\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" you \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"you\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" him/her/it        \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"them\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}"}, {"type": "text", "content": "Objects go at the end of the sentence. They receive the action."}, {"type": "text", "content": "<span class=\"italic\">Example: <br>Vanessa saw a movie on Saturday. <br/>Vanessa saw it on Saturday.</span><span class=\"prelo-letter-page-break\"></span>"}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Simple Past tense"}, {"type": "describer", "content": "You use the Simple Past to talk about an action that starts and finishes at a specific time in the past. "}, {"type": "text", "content": "You add -ed to regular verbs"}, {"type": "table", "content": "{\"rows\":6,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Verbs ending in a ...\\\"}\",\"\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" silent \u201ce\u201d    \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" close = closed<br/>  die = died<br/>  phone = phoned\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" vowel + y \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"play = played<br/>  destroy = destroyed <br/>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" consonant + y \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"marry = married <br/> carry = carried<br/>  study = studied\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" other forms\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" visit = visited</br>  miss = missed<br/> watch = watched <br/> finish = finished</br>  fix = fixed \\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}"}, {"type": "text", "content": "<span class=\"strong\">Important irregular verbs</span>"}, {"type": "text", "content": "The three most important irregular verbs are <span class=\"strong\">BE</span>,<span class=\"strong\"> HAVE</span>, and  <span class=\"strong\"> DO</span>."}, {"type": "table", "content": "{\"rows\":6,\"columns\":4,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Pronoun\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"BE  \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"HAVE\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"DO\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" I   \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"was\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"had\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"did\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" You \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"were \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"had \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"did\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" He / she / it \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"was\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"had \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"did\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" We\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" were \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"had \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"did\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" They \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"were \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"had \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"did\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}"}, {"type": "text", "content": "<span class=\"prelo-letter-page-break\"></span><span class=\"strong\">Other irregular verbs fall into three main categories:</span>"}, {"type": "table", "content": "{\"rows\":4,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Category \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Examples\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Verbs that don't change \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"cut - cut\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Verbs that change their vowel \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"get - got<br/> sit - sat<br/> drink - drank\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Verbs that change completely \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"catch - caught<br/> bring - brought<br/> teach - taught\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to begin"}, {"type": "definition", "content": "to start"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: How do you  begin a movie review?"}, {"type": "audio", "content": "engenn3le03ob08aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": "These are words you use when you talk about movies."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to end "}, {"type": "definition", "content": "to finish"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: How does a movie review end?"}, {"type": "audio", "content": "engenn3le03ob08aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to enjoy"}, {"type": "definition", "content": "to take pleasure in something"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: I really enjoyed it."}, {"type": "audio", "content": "engenn3le03ob08aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "awesome "}, {"type": "definition", "content": "extremely good"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: Sharon Simons and Ben Styler are awesome actors!"}, {"type": "audio", "content": "engenn3le03ob08aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to recommend"}, {"type": "definition", "content": "to feel a certain way about something"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: I can't recommend it to John."}, {"type": "audio", "content": "engenn3le03ob08aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "setting"}, {"type": "definition", "content": "where something happens; location"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: I really enjoyed the French setting."}, {"type": "audio", "content": "engenn3le03ob08aud06"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "introduction "}, {"type": "definition", "content": "the start; beginning"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: You begin a paragraph or speech with an introduction."}, {"type": "audio", "content": "engenn3le03ob08aud07"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "romance"}, {"type": "definition", "content": "excitement to do with love"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: I love romance novels."}, {"type": "audio", "content": "engenn3le03ob08aud08"}]}, {"type": "background_image", "content": "engenn3le03ob08re1img01.jpg"}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Write 5 sentences."}, {"type": "text", "content": "Include an introduction that includes the name of the author and title of the book. (2 sentences)"}, {"type": "text", "content": "Include the setting, character and what happened. (3 sentences)"}, {"type": "text", "content": "Would you recommend this book? (2 sentences)"}, {"type": "text", "content": "Share your review with a partner."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I write a review about a book."}, {"type": "text", "content": "I use capital letters and periods when I write a review."}, {"type": "text", "content": "I share my review with a partner."}]}]}